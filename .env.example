# ==========================================
# Sailboard Full-Stack Environment Variables
# ==========================================

# --- PostgreSQL Database ---
# Direct PostgreSQL connection string:
DATABASE_URL=postgresql://sailboard:sailboard_secret@localhost:5432/sailboard?schema=public

# --- Redis Cache & Pub/Sub ---
# For Docker Compose, the host is "redis". For local host run, use "localhost":
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Backend API Service ---
PORT=3333
API_PORT=3333
NODE_ENV=production
JWT_SECRET=sailboard_super_secret_jwt_key_2026_change_in_production

# --- Frontend Web Service (Vite / Nginx) ---
WEB_PORT=80
VITE_PORT=5173
VITE_API_BASE_URL=/api
VITE_SOCKET_URL=

# Target backend URL for development reverse proxy (/api, /socket.io, /whiteboard)
API_PROXY_TARGET=http://localhost:3333
VITE_PROXY_TARGET=http://localhost:3333
