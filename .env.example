# ==========================================
# Sailboard Full-Stack Environment Variables
# ==========================================

# --- PostgreSQL Database ---
POSTGRES_USER=sailboard
POSTGRES_PASSWORD=sailboard_secret
POSTGRES_DB=sailboard
POSTGRES_PORT=5432
# For Docker Compose, the host is "postgres". For local host run, use "localhost":
DATABASE_URL=postgresql://sailboard:sailboard_secret@postgres:5432/sailboard?schema=public

# --- Redis Cache & Pub/Sub ---
# For Docker Compose, the host is "redis". For local host run, use "localhost":
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Backend API Service ---
PORT=3333
API_PORT=3333
NODE_ENV=production
JWT_SECRET=sailboard_super_secret_jwt_key_2026_change_in_production

# --- Frontend Web Service (Vite / Nginx) ---
WEB_PORT=80
VITE_API_BASE_URL=/api
VITE_SOCKET_URL=
