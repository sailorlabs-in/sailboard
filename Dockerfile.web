# ========================================================
# Dockerfile for Sailboard Vite/React Frontend & Nginx
# ========================================================

# Stage 1: Build the production bundle
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package manifests and workspace configuration
COPY package*.json nx.json tsconfig*.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY libs/shared-types/package.json ./libs/shared-types/

# Install dependencies cleanly
RUN npm ci

# Copy shared library and Web application sources
COPY libs/shared-types ./libs/shared-types
COPY apps/web ./apps/web

# Build Vite production assets
RUN npx nx run web:build

# Stage 2: Serve static production assets via Nginx
FROM nginx:alpine AS runner

# Remove default Nginx welcome page
RUN rm -rf /usr/share/nginx/html/*

# Copy built production assets from builder stage
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Copy custom Nginx configuration with SPA routing and API/WebSocket proxying
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
